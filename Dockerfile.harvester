# ─── Harvester (Producer) ───
# Needs Selenium to traverse the catalog and bypass Cloudflare
FROM python:3.11-slim

WORKDIR /app

# Install Chromium + chromedriver for Selenium, plus Xvfb so SeleniumBase's
# UC mode can drive a real (non-headless) browser inside the container --
# headless mode is meaningfully less reliable against Cloudflare Turnstile.
RUN apt-get update && apt-get install -y --no-install-recommends \
    chromium \
    chromium-driver \
    xvfb \
    curl \
    && rm -rf /var/lib/apt/lists/*

# Symlink chromedriver for legacy compatibility
RUN ln -s /usr/bin/chromedriver /usr/local/bin/chromedriver || true

COPY requirements.txt /app/
RUN pip install --no-cache-dir -r /app/requirements.txt

# Copy source code
COPY src/ /app/src/
COPY spiders/ /app/spiders/
COPY database.py /app/database.py
COPY refresh_cookies.py /app/refresh_cookies.py

ENV PYTHONUNBUFFERED=1
ENV CODES_FILE=/app/data/product_codes.xlsx

CMD ["python", "-m", "spiders.hafele_harvester"]
