FROM python:3.9-slim

# Set the working directory inside the container
WORKDIR /app

# Ensure the ChromeDriver binary is in the default PATH
RUN ln -s /usr/bin/chromium-driver /usr/local/bin/chromedriver

# Copy requirements and install dependencies (place into WORKDIR so pip can find it)
COPY requirements.txt /app/src/input/
RUN pip install --no-cache-dir -r /app/src/input/requirements.txt

# Copy only the `src/` directory contents into `/app/src/`
COPY src/ /app/src/

# Add the wait-for-it.sh script for service readiness
COPY wait-for-it.sh /wait-for-it.sh
RUN chmod +x /wait-for-it.sh

# Set environment variables
ENV PYTHONUNBUFFERED=1
ENV webdriver.chrome.driver="/usr/bin/chromedriver"

# Run the application as module so package imports work
CMD ["bash", "/wait-for-it.sh", "selenium-hub", "4444", "--", "python", "-m", "src.input.send_product_code_mail"]
