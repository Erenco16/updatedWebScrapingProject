# ─── Reporter ───
# Generates Excel and sends emails after consumers finish
FROM python:3.11-slim

WORKDIR /app

COPY requirements.txt /app/
RUN pip install --no-cache-dir -r /app/requirements.txt

COPY src/ /app/src/
# reporter now imports spiders.models (SKU dot formatter) and
# spiders.dinler_log (end-of-run fallback summary), so it needs the
# spiders package in the image too.
COPY spiders/ /app/spiders/
COPY database.py /app/database.py
COPY reporter.py /app/reporter.py

ENV PYTHONUNBUFFERED=1
ENV DB_PATH=/app/data/products.db
ENV OUTPUT_DIR=/app/data

CMD ["python", "-m", "reporter"]
